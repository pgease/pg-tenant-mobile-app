{
  "appId": "in.pgease.tenant",
  "appName": "PG Ease Tenant",
  "webDir": "dist",
  "appendUserAgent": "PGEaseApp",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": true,
    "url": "https://tenant.pgease.com?app=1"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "backgroundColor": "#008080",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#008080",
      "overlaysWebView": true
    },
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "disable",
      "initialViewportFitValueHint": "cover"
    },
    "App": {
      "disableBackButtonHandler": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}